{
  "name": "requesto-backend",
  "version": "1.0.0",
  "description": "Backend API proxy for Requesto",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./errors/*": {
      "types": "./dist/errors/*.d.ts",
      "default": "./dist/errors/*.js"
    },
    "./models/*": {
      "types": "./dist/models/*.d.ts",
      "default": "./dist/models/*.js"
    },
    "./repositories/*": {
      "types": "./dist/repositories/*.d.ts",
      "default": "./dist/repositories/*.js"
    },
    "./services/*": {
      "types": "./dist/services/*.d.ts",
      "default": "./dist/services/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "axios": "^1.20.0",
    "fastify": "^5.12.1",
    "form-data": "^4.0.6",
    "graphql": "^17.0.2",
    "node-fetch": "^3.3.2",
    "simple-git": "^3.36.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/node-fetch": "^2.6.13",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
