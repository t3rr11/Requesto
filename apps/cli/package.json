{
  "name": "@requesto/cli",
  "version": "1.12.0",
  "description": "Run your Requesto collections from the terminal and CI pipelines",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": {
    "requesto": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "node scripts/bundle.mjs",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "requesto-backend": "1.12.0",
    "requesto-engine": "1.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
