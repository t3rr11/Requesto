# Environment variables for Requesto

# Backend Configuration
PORT=4747
HOST=0.0.0.0
NODE_ENV=production

# Data Directory (optional, defaults to ./data)
# DATA_DIR=/path/to/data

# CORS Configuration (optional, defaults to allow all)
# CORS_ORIGIN=http://localhost:5173

# Website monitoring (apps/website, optional - OpenObserve RUM)
# OO_SITE=https://your-openobserve-host:5080
# OO_CLIENT_TOKEN=your-rum-client-token
# OO_ORGANIZATION_ID=default
# OO_ENVIRONMENT=production
