# ── Build stage: compile backend + CLI with dev dependencies ─────────────────
FROM node:24-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/cli/package.json apps/cli/package.json
RUN npm ci --workspace=requesto-backend --workspace=requesto-cli

COPY apps/backend/ apps/backend/
COPY apps/cli/ apps/cli/
RUN npm run build -w requesto-backend && npm run build -w requesto-cli

# ── Runtime stage: production dependencies + compiled output only ────────────
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/cli/package.json apps/cli/package.json
RUN npm ci --omit=dev --workspace=requesto-backend --workspace=requesto-cli \
  && npm cache clean --force

COPY --from=build /app/apps/backend/dist apps/backend/dist
COPY --from=build /app/apps/cli/dist apps/cli/dist

# The `requesto` binary (see apps/cli/package.json "bin")
RUN chmod +x apps/cli/dist/index.js \
  && ln -s /app/apps/cli/dist/index.js /usr/local/bin/requesto

# Default workspace mount point
RUN mkdir /work && chown node:node /work
WORKDIR /work
USER node

ENTRYPOINT ["requesto"]
